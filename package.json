{
  "name": "@absolutejs/agent-modules",
  "private": true,
  "type": "module",
  "description": "Independently published modules for the AbsoluteJS agent stack.",
  "workspaces": [
    "conformance",
    "control",
    "discovery",
    "inbox",
    "memory",
    "reputation",
    "runtime",
    "sandbox",
    "trust"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "check:package": "bun run --filter './*' check:package",
    "format": "bun run --filter './*' format",
    "test": "bun run --filter './*' test",
    "typecheck": "bun run --filter './*' typecheck"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
